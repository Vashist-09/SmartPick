DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
PORT=5050
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
STUDENT_APP_ORIGIN=http://localhost:5173
ESP32_API_KEY=replace-with-a-long-random-device-key
# Keep false unless testing sample data on a private localhost environment.
ENABLE_DEV_MAILBOX=false
# Required for real verification, recovery and notification emails.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_KEY=
# Set NODE_ENV=production on deployment to require Secure cookies and disable dev mailbox.
