{
  "name": "smartpick-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "provision:operator": "npm run build && node dist/provision-operator.js",
    "preview:seed": "npm run build && node scripts/preview.cjs",
    "simulate:device": "node scripts/simulate-device.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
